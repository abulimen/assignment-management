# ─────────────────────────────────────────────────────────────────────────────
# Draftly — environment template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. For local dev you can run
# `./start.sh` with no `.env` and the loopback defaults below apply; for any
# deployment that is reachable beyond 127.0.0.1 you MUST set the secrets.
#
#   cp .env.example .env
#
# .env is git-ignored; never commit real secrets.

# ---- Database ---------------------------------------------------------------
# Matches shared/core loadConfig() + collab db block.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=assignment_mgmt

# ---- Auth secrets (SHARE one secret across ALL services) --------------------
# HSD256 JWT secret. REQUIRED for anything beyond loopback dev — the code
# default is the well-known placeholder "CHANGE_ME_IN_PRODDUCTION".
# Generate a strong one:  openssl rand -hex 32
JWT_SECRET=

# Shared secret protecting the collab INTERNAL API (:8004 /seal /state).
# REQUIRED beyond loopback dev — the default is the well-known
# "local-dev-internal-secret".
# Generate:  openssl rand -hex 16
INTERNAL_API_SECRET=

# ---- Email (Resend) ---------------------------------------------------------
# Resend API key. When set, auth emails go to the Resend HTTP API; when unset
# (local dev) they are logged to /tmp/mailer.log as clickable links instead.
RESEND_API_KEY=
# Sender shown on verification + reset emails. Must be on a domain you've
# verified in Resend.
MAIL_FROM="Draftly <no-reply@draftly.local>"

# ---- External origins / URLs ------------------------------------------------
# The browser-facing origin the SPA runs at — used to build absolute
# verify-email & reset-password links in emails.
# Local dev:  http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# CORS allow-list for the API when served from a different origin than the API
# (loopback dev already allows localhost:3000/8001 by default).
CORS_ORIGIN=http://localhost:3000

# ---- Service-to-service URLs (defaults for the local stack) -----------------
ANALYZER_URL=http://127.0.0.1:8002
COLLAB_INTERNAL_URL=http://127.0.0.1:8004

# ---- Service ports (defaults match start.sh) --------------------------------
API_PORT=8001
# NODE_ENV=production turns on Secure cookies + HSTS automatically
NODE_ENV=development